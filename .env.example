# AI Provider Configuration
AI_PROVIDER=ollama# Options: 'anthropic', 'ollama', 'openai'

# Anthropic (if using)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (if using)
OPENAI_API_KEY=sk-your-key-here

# Ollama (if using)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder
OLLAMA_TIMEOUT=600  # Request timeout in seconds (default: 600 = 10 minutes)

# Flask Configuration
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Features
ENABLE_CACHE=True
ENABLE_VALIDATION=True